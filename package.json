{
  "name": "soak-up",
  "version": "0.0.7",
  "keywords": [
    "web-components",
    "web-component",
    "custom-element",
    "custom-elements",
    "enhancement",
    "behavior"
  ],
  "description": "Absorb temporary light children into the upgraded schema",
  "files": [
    "*.js",
    "*.json",
    "*.mjs",
    "./types/soak-up/types.d.ts",
    "README.md"
  ],
  "types": "./types/soak-up/types.d.ts",
  "homepage": "https://github.com/bahrus/soak-up#readme",
  "bugs": {
    "url": "https://github.com/bahrus/soak-up/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/soak-up.git"
  },
  "license": "MIT",
  "author": "Bruce B. Anderson <anderson.bruce.b@gmail.com>",
  "type": "module",
  "main": "soak-up.js",
  "module": "soak-up.js",
  "dependencies": {
    "assign-gingerly": "0.0.72",
    "be-hive": "0.1.16",
    "mount-observer": "0.1.43",
    "roundabout-lib": "0.0.30",
    "nested-regex-groups": "0.0.8"
  },
  "exports": {
    "./*": "./*.js",
    "./soak-up.js": "./soak-up.js"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "spa-ssi": "0.0.27"
  },
  "scripts": {
    "build": "node emc.mjs > emc.json && node 🧽.mjs > 🧽.json",
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "test": "playwright test",
    "safari": "npx playwright wk http://localhost:8000",
    "update": "ncu -u && npm install"
  }
}
